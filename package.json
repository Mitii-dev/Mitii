{
  "name": "mitii-ai-agent",
  "description": "Private Mitii monorepo workspace orchestrator. Product packages: @mitii/v8, @mitii/sdk, @mitii/automation, @mitii/search-kit, @mitii/mcp, @mitii/mcp-web, @mitii/host, @mitii/cli, @mitii/daemon, @mitii/acp, apps/vscode.",
  "version": "2.9.56",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "codewithshinde",
    "email": "codewithshinde@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mitii-dev/Mitii.git"
  },
  "bugs": {
    "url": "https://github.com/Mitii-dev/Mitii/issues"
  },
  "homepage": "https://mitii.dev",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "scripts": {
    "build": "pnpm -r --filter @mitii/v8 --filter @mitii/sdk --filter @mitii/automation --filter @mitii/search-kit --filter @mitii/mcp --filter @mitii/mcp-web --filter @mitii/host --filter @mitii/cli --filter @mitii/daemon --filter @mitii/acp --filter ./apps/vscode run build",
    "build:all": "pnpm run build && pnpm run rebuild:native",
    "build:v8": "pnpm --filter @mitii/v8 build",
    "build:sdk": "pnpm --filter @mitii/sdk build",
    "build:automation": "pnpm --filter @mitii/automation build",
    "build:search-kit": "pnpm --filter @mitii/search-kit build",
    "build:mcp": "pnpm --filter @mitii/mcp build",
    "build:mcp-web": "pnpm --filter @mitii/mcp-web build",
    "build:host": "pnpm -r --filter @mitii/host... run build",
    "build:cli": "pnpm -r --filter @mitii/cli... run build",
    "build:daemon": "pnpm -r --filter @mitii/daemon... run build",
    "build:acp": "pnpm -r --filter @mitii/acp... run build",
    "build:vscode": "pnpm --filter ./apps/vscode build",
    "build:vscode:prod": "pnpm --filter ./apps/vscode build:prod",
    "typecheck": "pnpm run typecheck:v8 && pnpm run build:v8 && pnpm run typecheck:sdk && pnpm run build:sdk && pnpm run typecheck:automation && pnpm run build:automation && pnpm run typecheck:search-kit && pnpm run build:search-kit && pnpm run typecheck:mcp && pnpm run build:mcp && pnpm run typecheck:mcp-web && pnpm run build:mcp-web && pnpm run typecheck:host && pnpm run build:host && pnpm run typecheck:cli && pnpm run typecheck:daemon && pnpm run typecheck:acp && pnpm run typecheck:vscode",
    "typecheck:v8": "pnpm --filter @mitii/v8 typecheck",
    "typecheck:sdk": "pnpm --filter @mitii/sdk typecheck",
    "typecheck:automation": "pnpm --filter @mitii/automation typecheck",
    "typecheck:search-kit": "pnpm --filter @mitii/search-kit typecheck",
    "typecheck:mcp": "pnpm --filter @mitii/mcp typecheck",
    "typecheck:mcp-web": "pnpm --filter @mitii/mcp-web typecheck",
    "typecheck:host": "pnpm --filter @mitii/host typecheck",
    "typecheck:cli": "pnpm --filter @mitii/cli typecheck",
    "typecheck:daemon": "pnpm --filter @mitii/daemon typecheck",
    "typecheck:acp": "pnpm --filter @mitii/acp typecheck",
    "typecheck:vscode": "pnpm --filter ./apps/vscode typecheck",
    "test": "node scripts/ensure-node-native.mjs && vitest run",
    "test:watch": "node scripts/ensure-node-native.mjs && vitest",
    "test:v8": "pnpm --filter @mitii/v8 test",
    "test:sdk": "pnpm --filter @mitii/sdk test",
    "test:search-kit": "pnpm --filter @mitii/search-kit test",
    "test:cli": "pnpm --filter @mitii/cli test",
    "check:architecture": "vitest run packages/v8/tests/architecture/v8-module-boundaries.test.ts",
    "verify": "pnpm run typecheck && pnpm test && pnpm run build:all",
    "verify:launch": "node scripts/verify-f5-launch.mjs",
    "package": "pnpm --filter ./apps/vscode package",
    "package:preflight": "pnpm run preflight && pnpm run package",
    "preflight": "pnpm run release:check-assets && pnpm run typecheck && pnpm test && pnpm run rebuild:native",
    "release:check-assets": "node scripts/check-release-assets.mjs",
    "publish:vsce": "node scripts/publish-vscode-vsix.cjs",
    "publish:ovsx": "node scripts/publish-ovsx-vsix.cjs",
    "publish:npm": "node scripts/publish-npm.cjs",
    "benchmark": "pnpm --filter @mitii/solid-benchmark benchmark",
    "benchmark:frontend": "pnpm --filter @mitii/solid-benchmark benchmark:frontend",
    "benchmark:backend": "pnpm --filter @mitii/solid-benchmark benchmark:backend",
    "benchmark:cicd": "pnpm --filter @mitii/solid-benchmark benchmark:cicd",
    "benchmark:testing": "pnpm --filter @mitii/solid-benchmark benchmark:testing",
    "benchmark:validate": "pnpm --filter @mitii/solid-benchmark validate",
    "benchmark:fixtures": "pnpm --filter @mitii/solid-benchmark fixtures:reset",
    "benchmark:reset": "pnpm --filter @mitii/solid-benchmark fixtures:reset",
    "benchmark:prepare": "pnpm --filter @mitii/solid-benchmark fixtures:reset",
    "benchmark:fixtures:install-only": "pnpm --filter @mitii/solid-benchmark fixtures:install",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "rebuild:node": "node scripts/rebuild-node.mjs",
    "sync:versions": "node scripts/sync-versions.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "version:major": "pnpm version major --no-git-tag-version --force && pnpm run readme:sync-version && pnpm run sync:versions",
    "version:minor": "pnpm version minor --no-git-tag-version --force && pnpm run readme:sync-version && pnpm run sync:versions",
    "version:patch": "pnpm version patch --no-git-tag-version --force && pnpm run readme:sync-version && pnpm run sync:versions",
    "readme:sync-version": "node scripts/sync-readme-version.mjs",
    "setup": "bash scripts/dev-setup.sh",
    "setup:cursor": "MITII_EDITOR=cursor bash scripts/dev-setup.sh",
    "prepare": "node scripts/install-git-hooks.mjs",
    "postinstall": "node -e \"console.log('Run pnpm run build:all (or rebuild:native) before F5. rebuild:native stages Electron SQLite and restores Node ABI for tests.')\"",
    "policy-admin": "node tools/policy-admin/server.mjs",
    "log-viewer": "node tools/log-viewer/server.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:engines": "node scripts/audit-package-engines.mjs",
    "check:circular-deps": "node scripts/check-circular-deps.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^20.14.0",
    "knip": "^6.21.0",
    "madge": "^8.0.0",
    "typescript": "^5.5.2",
    "vitest": "^3.2.7"
  },
  "knip": {
    "ignoreDependencies": [
      "madge"
    ]
  }
}
