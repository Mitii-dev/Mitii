{
  "name": "mitii-ai-agent",
  "description": "Private Mitii monorepo workspace (orchestrator). Product packages: @mitii/v8, @mitii/sdk, @mitii/cli, @mitii/vscode.",
  "version": "2.7.118",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "codewithshinde",
    "email": "codewithshinde@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mitii-dev/Mitii.git"
  },
  "bugs": {
    "url": "https://github.com/Mitii-dev/Mitii/issues"
  },
  "homepage": "https://mitii.dev",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "audit:dead-code": "bash scripts/audit-dead-code.sh",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "audit:engines": "node scripts/audit-package-engines.mjs",
    "benchmark": "pnpm --filter @mitii/solid-benchmark benchmark",
    "benchmark:validate": "pnpm --filter @mitii/solid-benchmark validate",
    "benchmark:fixtures": "pnpm --filter @mitii/solid-benchmark fixtures:install",
    "build": "pnpm run compile",
    "build:cli": "pnpm --filter @mitii/cli build",
    "build:sdk": "pnpm --filter @mitii/sdk build",
    "build:v8": "pnpm --filter @mitii/v8 build",
    "build:vscode": "pnpm --filter @mitii/vscode build",
    "check:architecture": "vitest run test/architecture/v8-module-boundaries.test.ts",
    "check:circular-deps": "node scripts/check-circular-deps.mjs",
    "check:missing-types": "bash scripts/check-missing-types.sh",
    "checkpoint:read": "bash scripts/read-checkpoint.sh",
    "checkpoint:write": "bash scripts/write-checkpoint.sh",
    "clean:vsce-deps": "node -e \"const fs=require('fs'); for (const p of ['node_modules/@emnapi','node_modules/@napi-rs','node_modules/@tybys']) fs.rmSync(p,{recursive:true,force:true});\"",
    "compile": "pnpm run compile:extension && pnpm run compile:cli",
    "compile:cli": "pnpm --filter @mitii/cli build",
    "compile:extension": "pnpm --filter @mitii/vscode build",
    "env:sync": "node scripts/sync-env-files.mjs",
    "find:console": "bash scripts/find-console-logs.sh",
    "find:inline-styles": "bash scripts/find-inline-styles.sh",
    "git:untracked": "bash scripts/list-untracked-files.sh",
    "legacy:purge": "node scripts/legacy-purge.mjs",
    "lint": "pnpm run typecheck:v8 && pnpm run typecheck:sdk",
    "lint:safe-target": "bash scripts/safe-lint-target.sh",
    "package": "pnpm --filter @mitii/vscode package",
    "package:preflight": "pnpm run preflight && pnpm run package",
    "postinstall": "node -e \"console.log('Run pnpm run rebuild:native before F5 if native modules or MiniLM embeddings fail to load')\"",
    "preflight": "pnpm run release:check-assets && pnpm run lint && pnpm run rebuild:node && pnpm test && pnpm run rebuild:native",
    "prepare": "node scripts/install-git-hooks.mjs",
    "publish:major": "pnpm run version:major && pnpm run publish:vsce",
    "publish:minor": "pnpm run version:minor && pnpm run publish:vsce",
    "publish:ovsx": "pnpm dlx ovsx publish",
    "publish:patch": "pnpm run version:patch && pnpm run publish:vsce",
    "publish:vsce": "pnpm run preflight && pnpm run clean:vsce-deps && pnpm exec vsce publish",
    "readme:sync-version": "node scripts/sync-readme-version.mjs",
    "rebuild:all": "pnpm run rebuild:native && pnpm run rebuild:node",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "rebuild:node": "node scripts/rebuild-node.mjs",
    "release:all": "pnpm test && pnpm run package && pnpm run publish:ovsx",
    "release:check-assets": "node scripts/check-release-assets.mjs",
    "release:prepare": "pnpm --filter @mitii/cli build && echo 'prepare-release: use apps/cli + docs/RELEASE.md'",
    "scripts:search": "node scripts/search-script-catalog.mjs",
    "sdk:build": "pnpm --filter @mitii/sdk build",
    "sdk:sync-version": "node scripts/sync-sdk-version.mjs",
    "setup": "bash scripts/dev-setup.sh",
    "setup:cursor": "MITII_EDITOR=cursor bash scripts/dev-setup.sh",
    "sync:versions": "node scripts/sync-versions.mjs",
    "test": "vitest run",
    "test:cli": "pnpm --filter @mitii/cli test",
    "test:sdk": "pnpm --filter @mitii/sdk test",
    "test:v8": "pnpm --filter @mitii/v8 test",
    "test:watch": "vitest",
    "typecheck": "pnpm run typecheck:v8 && pnpm run typecheck:sdk",
    "typecheck:sdk": "pnpm --filter @mitii/sdk typecheck",
    "typecheck:v8": "pnpm --filter @mitii/v8 typecheck",
    "verify": "pnpm run typecheck && pnpm test && pnpm run build",
    "version:bump": "node scripts/bump-version.mjs",
    "version:major": "pnpm version major --no-git-tag-version --force && pnpm run readme:sync-version",
    "version:minor": "pnpm version minor --no-git-tag-version --force && pnpm run readme:sync-version",
    "version:patch": "pnpm version patch --no-git-tag-version --force && pnpm run readme:sync-version",
    "vscode:prepublish": "pnpm --filter @mitii/vscode build"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vscode/vsce": "^3.9.2",
    "concurrently": "^8.2.2",
    "esbuild": "^0.25.12",
    "knip": "^6.21.0",
    "madge": "^8.0.0",
    "typescript": "^5.5.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1078.0",
    "@lancedb/lancedb": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vscode/ripgrep": "^1.15.9",
    "@xenova/transformers": "^2.17.2",
    "@xstate/react": "^6.1.0",
    "better-sqlite3": "^12.11.1",
    "diff": "^5.2.0",
    "framer-motion": "^12.42.0",
    "ignore": "^5.3.1",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^4.3.0",
    "simple-git": "^3.25.0",
    "tiktoken": "^1.0.22",
    "ts-morph": "^28.0.0",
    "xstate": "^5.32.2",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "optionalDependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.24.7"
  },
  "knip": {
    "ignoreDependencies": [
      "madge"
    ]
  },
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "private": true
}
