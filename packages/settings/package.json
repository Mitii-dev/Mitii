{
  "name": "@mitii/settings",
  "version": "2.11.27",
  "description": "Shared Mitii settings catalog (single source of truth for mitii.* keys): contract, defaults, nesting helpers, and VS Code contributes projection.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mitii-dev/Mitii.git",
    "directory": "packages/settings"
  },
  "homepage": "https://github.com/Mitii-dev/Mitii/tree/main/packages/settings",
  "bugs": {
    "url": "https://github.com/Mitii-dev/Mitii/issues"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').accessSync('dist/index.js'); require('node:fs').accessSync('dist/data/catalog.json')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:vscode-contributes": "node scripts/check-vscode-contributes.mjs"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.2",
    "vitest": "^3.2.7"
  }
}
