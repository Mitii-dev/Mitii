{
  "name": "@mitii/ui-theme",
  "version": "2.11.43",
  "description": "Shared --mitii-* CSS token contract for Mitii Desktop and VS Code, with vscode and standalone adapters.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./css/tokens.css",
    "./vscode.css": "./css/vscode.css",
    "./standalone.css": "./css/standalone.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mitii-dev/Mitii.git",
    "directory": "packages/ui-theme"
  },
  "homepage": "https://github.com/Mitii-dev/Mitii/tree/main/packages/ui-theme",
  "bugs": {
    "url": "https://github.com/Mitii-dev/Mitii/issues"
  },
  "files": [
    "dist",
    "css",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').accessSync('dist/index.js')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.2",
    "vitest": "^3.2.7"
  }
}
