{
  "name": "@mitii/host",
  "version": "2.11.56",
  "description": "Shared host kit for Mitii apps: SQLite injection, workspace indexing, repository context, durable ports (checkpoints/memory/skills/search/network), project rules, prepareStartInput, provider presets. Web retrieval via @mitii/search-kit.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mitii-dev/Mitii.git",
    "directory": "packages/host"
  },
  "homepage": "https://github.com/Mitii-dev/Mitii/tree/main/packages/host",
  "bugs": {
    "url": "https://github.com/Mitii-dev/Mitii/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ../../scripts/assert-workspace-dep-built.mjs --from-package-json . && node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').accessSync('dist/index.js')\"",
    "typecheck": "node ../../scripts/assert-workspace-dep-built.mjs --from-package-json . && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mitii/automation": "workspace:*",
    "@mitii/mcp": "workspace:*",
    "@mitii/sdk": "workspace:*",
    "@mitii/search-kit": "workspace:*",
    "@mitii/ui-core": "workspace:*",
    "@mitii/v8": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.2",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "@ast-grep/cli": "^0.51.3",
    "@bufbuild/protobuf": "^2.2.0",
    "@lancedb/lancedb": "0.33.0",
    "@scip-code/scip": "^0.10.0",
    "@vscode/ripgrep": "^1.18.0",
    "es-git": "^0.7.0",
    "onnxruntime-node": "1.21.0",
    "onnxruntime-web": "1.21.0",
    "tree-sitter": "^0.22.4",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.24.7"
  }
}
