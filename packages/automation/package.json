{
  "name": "@mitii/automation",
  "version": "2.8.84",
  "description": "Mitii automation control plane: schedules, event ingress, claim/lease runner, webhooks (Phases 1–2).",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mitii-dev/Mitii.git",
    "directory": "packages/automation"
  },
  "homepage": "https://github.com/Mitii-dev/Mitii/tree/main/packages/automation",
  "bugs": {
    "url": "https://github.com/Mitii-dev/Mitii/issues"
  },
  "files": [
    "dist",
    "ARCHITECTURE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').accessSync('dist/index.js')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/ensure-node-native.mjs && vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.2",
    "vitest": "^3.2.7"
  }
}
