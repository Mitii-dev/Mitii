{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (apps/vscode)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.js"],
      "preLaunchTask": "mitii: prelaunch"
    },
    {
      "name": "Run Extension (fixture: node-express)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode",
        "${workspaceFolder}/tests/benchmark/fixtures/node-express"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode/dist/**/*.js"],
      "preLaunchTask": "mitii: prelaunch"
    }
  ]
}
