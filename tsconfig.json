{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": true
  },
  "include": [
    "tests/architecture/**/*.ts",
    "tests/packages/**/*.ts",
    "tests/contract/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/setup.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "legacy",
    "packages",
    "apps",
    "tests/benchmark"
  ]
}
