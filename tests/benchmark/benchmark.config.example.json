{
  "agent": {
    "command": "node",
    "args": [
      "tests/benchmark/scripts/mitii-benchmark-agent.mjs",
      "--mode",
      "{mode}",
      "--prompt",
      "{prompt}",
      "--cwd",
      "{workspace}"
    ],
    "cwd": "../..",
    "timeoutMs": 300000,
    "env": {}
  },
  "run": {
    "concurrency": 1,
    "keepWorkspaces": false,
    "ignoreChanges": [
      ".git",
      ".mitii",
      "node_modules",
      "dist",
      ".next",
      "coverage",
      "tsconfig.tsbuildinfo",
      "*.tsbuildinfo"
    ]
  },
  "gates": {
    "easy": 0.95,
    "medium": 0.85,
    "hard": 0.7,
    "overall": 0.85
  }
}
