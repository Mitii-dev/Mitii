{
  "name": "benchmark-frontend-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mitii frontend benchmark fixture — Vite + React + TypeScript baseline for agent FE tasks.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
