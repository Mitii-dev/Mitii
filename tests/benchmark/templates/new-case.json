{
  "id": "fe-feature-001-about-page-v1",
  "familyId": "fe-feature-about-page",
  "variant": 1,
  "suite": "frontend",
  "category": "routing",
  "difficulty": "medium",
  "mode": "agent",
  "capability": "feature",
  "fixture": "next-app",
  "prompt": "Add a new /about route with a static page that renders the exact text \"About this benchmark app\".",
  "rationale": "App Router page addition graded by __bench__/grade.mjs + build. One variant only.",
  "preconditions": [
    {
      "type": "file_not_exists",
      "path": "app/about/page.tsx"
    }
  ],
  "checks": [
    {
      "type": "agent_exit",
      "equals": 0
    },
    {
      "type": "output_not_empty"
    },
    {
      "type": "jsonl_event",
      "event": "end"
    },
    {
      "type": "workspace_changed"
    },
    {
      "type": "file_exists",
      "path": "app/about/page.tsx"
    },
    {
      "type": "command",
      "command": "node __bench__/grade.mjs --json \"[{\\\"op\\\":\\\"exists\\\",\\\"path\\\":\\\"app/about/page.tsx\\\"},{\\\"op\\\":\\\"contains\\\",\\\"path\\\":\\\"app/about/page.tsx\\\",\\\"value\\\":\\\"About this benchmark app\\\"}]\"",
      "timeoutMs": 30000
    },
    {
      "type": "command",
      "command": "npm run build",
      "timeoutMs": 180000
    }
  ]
}
