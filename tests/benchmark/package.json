{
  "name": "@mitii/solid-benchmark",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Domain-first coding-agent benchmark: frontend, backend, cicd, and testing suites organized by category/tech-family, with per-case reporting and a read-only test case browser.",
  "scripts": {
    "validate": "node src/cli.mjs validate",
    "list": "node src/cli.mjs list",
    "suites": "node src/cli.mjs suites",
    "benchmark": "node src/cli.mjs run",
    "benchmark:frontend": "node src/cli.mjs run --suite frontend",
    "benchmark:backend": "node src/cli.mjs run --suite backend",
    "benchmark:cicd": "node src/cli.mjs run --suite cicd",
    "benchmark:testing": "node src/cli.mjs run --suite testing",
    "view": "node src/cli.mjs view",
    "view:open": "node src/cli.mjs view --open",
    "cases": "node src/cli.mjs cases",
    "cases:open": "node src/cli.mjs cases --open",
    "generate:frontend": "node scripts/write-frontend-core.mjs",
    "migrate:domains": "node scripts/migrate-to-domains.mjs",
    "fixtures:install": "node scripts/install-fixtures.mjs",
    "fixtures:reset": "node scripts/reset-fixtures.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "better-sqlite3": "^12.11.1",
    "yaml": "^2.9.0"
  }
}
