{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mitii.local/schemas/solid-benchmark-case.schema.json",
  "title": "Mitii Domain Benchmark Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "familyId",
    "variant",
    "difficulty",
    "mode",
    "capability",
    "fixture",
    "prompt",
    "rationale",
    "preconditions",
    "checks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "familyId": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "type": "integer",
      "minimum": 1
    },
    "suite": {
      "enum": ["frontend", "backend", "cicd", "testing"]
    },
    "category": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "difficulty": {
      "enum": ["easy", "medium", "hard"]
    },
    "mode": {
      "enum": ["ask", "plan", "agent"]
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "string",
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1
    },
    "preconditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "agent_exit",
            "output_not_empty",
            "output_contains",
            "output_contains_any",
            "output_not_contains",
            "output_regex",
            "jsonl_event",
            "json_path_truthy",
            "file_exists",
            "file_not_exists",
            "file_contains",
            "file_not_contains",
            "file_contains_any",
            "dir_has_files",
            "workspace_unchanged",
            "workspace_changed",
            "file_unchanged",
            "file_changed",
            "command",
            "http",
            "skills_installed"
          ]
        },
        "equals": {
          "type": "integer"
        },
        "value": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "scope": {
          "enum": ["all", "model"]
        },
        "pattern": {
          "type": "string"
        },
        "flags": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "minimum": {
          "type": "integer",
          "minimum": 0
        },
        "command": {
          "type": "string"
        },
        "requests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "method": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "json": {},
              "expect": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "integer"
                  },
                  "bodyContains": {
                    "type": "string"
                  },
                  "jsonType": {
                    "type": "string"
                  },
                  "jsonSubset": {},
                  "jsonPaths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "exitCode": {
          "type": "integer"
        },
        "stdoutContains": {
          "type": "string"
        },
        "start": {
          "type": "object",
          "required": ["command"],
          "properties": {
            "command": {
              "type": "string"
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "request": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "method": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "json": {}
          },
          "additionalProperties": false
        },
        "expect": {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "bodyContains": {
              "type": "string"
            },
            "jsonType": {
              "enum": ["array", "object", "string", "number", "boolean", "null"]
            },
            "jsonSubset": {},
            "jsonPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
