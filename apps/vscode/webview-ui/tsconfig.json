{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "paths": {
      "@mitii/ui-core": ["../../../packages/ui-core/src/index.ts"],
      "@mitii/ui-react": ["../../../packages/ui-react/src/index.ts"],
      "@mitii/ui-protocol": ["../../../packages/ui-protocol/src/index.ts"]
    }
  },
  "include": ["src"]
}
