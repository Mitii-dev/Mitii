# Copy to the workspace root as `.env` or `.mitii/.env` (gitignored).
# Shell / CI env vars always win over these files.
# Docs: https://docs.mitii.dev/using/CLI/environment

# --- Provider (pick one) ---
MITII_PROVIDER=anthropic
MITII_MODEL=claude-sonnet-4-5
# MITII_PROVIDER=openai-compatible
# MITII_BASE_URL=http://localhost:11434/v1
# MITII_MODEL=qwen3-coder:30b
# MITII_API_KEY=ollama

# --- API keys (use the one matching your provider) ---
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# MITII_API_KEY=

# --- Optional ---
# MITII_CONTEXT_WINDOW=200000
# MITII_LOGS_PATH=/tmp/mitii-logs
# MITII_CLI_LOG=1
# SEARXNG_BASE_URL=http://127.0.0.1:8080
# MITII_SANDBOX=1
# MITII_SANDBOX_NETWORK=deny
