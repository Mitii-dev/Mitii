#!/bin/sh
set -e

# Bump root version, sync README badge + all product package.json versions, then stage.
# Staging of product packages comes from sync-versions.mjs --stage so new packages
# cannot be forgotten the way packages/search-kit was.
node scripts/bump-version.mjs
node scripts/sync-readme-version.mjs
node scripts/sync-versions.mjs --stage

git add package.json README.md
